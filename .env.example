APP_ENV=local
APP_URL=http://localhost:8080

POSTGRES_DB=tribux
POSTGRES_USER=tribux
POSTGRES_PASSWORD=tribux_dev_only
POSTGRES_PORT=5432

REDIS_PORT=6379

# Non-secret DIAN configuration of every issuer, keyed by issuer id.
# Mount the file; never commit it. See examples/issuer.habilitation.json.
TRIBUX_ISSUERS_FILE=

# Directory of mounted secret files, one per credential reference.
# Holds the software PIN, the technical key and the signing material.
# MUST NOT be committed and MUST NOT be readable by other containers.
TRIBUX_SECRETS_PATH=

# Where XML, ZIP and SOAP evidence is written. The local driver is for
# development only: legal documents must not live solely on a container.
TRIBUX_EVIDENCE_DISK=evidence
TRIBUX_EVIDENCE_PATH=

# A SOAP request envelope carries the whole signed document, so storing it is
# opt-in.
TRIBUX_EVIDENCE_STORE_SOAP_REQUESTS=false
